    0.0,\n        \"e32\": 0.0,\n        \"e33\": 1.0\n    }\n}\n\n{\n    \"m_SGVersion\":
    0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.StickyNoteData\",\n    \"m_ObjectId\":
    \"cf425746c7f840108d1cd317a3498cca\",\n    \"m_Title\": \"Why does this work
    on opaque surfaces?\",\n    \"m_Content\": \"The depth intersection technique
    requires a depth map to compare two pixels' depth. This map is usually only available
    after all opaque objects have been drawn, so we usually need to make our object
    transparent so we can use the depth buffer while rendering it.\\n\\nIt seems
    that enabling \\\"receive decals\\\" on materials fixes this.\\n\\nMy assumption
    is that this setting pushes the material's rendering to a later stage where the
    depth buffer has already been written to, or something of the sort.\",\n    \"m_TextSize\":
    1,\n    \"m_Theme\": 0,\n    \"m_Position\": {\n        \"serializedVersion\":
    \"2\",\n        \"x\": -264.0,\n        \"y\": -6105.0,\n        \"width\": 497.0,\n       
    \"height\": 584.0\n    },\n    \"m_Group\": {\n        \"m_Id\": \"\"\n    }\n}\n\n{\n   
